<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme. Compose-driven UI (MaterialExpressiveTheme) renders
         on top; this theme only governs window-level chrome (splash background,
         status-bar handling). The Light parent is incidental — windowBackground
         is overridden to the bat-charcoal so the system splash + cold-start
         frame don't flashbang against the dark Compose surface. -->
    <style name="Base.Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- API 26-30. values-v31/themes.xml adds the SplashScreen API attrs. -->
    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

</resources>
