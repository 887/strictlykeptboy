<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Round 2.18.B.1 — calendar replacement read/write -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Round 2.18.G.1 — AccountManager + sync adapter surface -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />

    <!-- Round 2.18.H — Android 11+ package visibility. The Connect
         Accounts screen probes for DAVx5 / F-Droid clients / existing
         Exchange accounts; without this block `getApplicationInfo`
         would always throw NameNotFoundException even when the package
         is installed. -->
    <queries>
        <package android:name="at.bitfire.davdroid" />
        <package android:name="com.android.exchange" />
        <package android:name="org.fdroid.fdroid" />
        <package android:name="com.aurora.adroid" />
    </queries>

    <application
        android:name=".SkbApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Round 2.18.E.1 — surface skb in the system's
                     "Calendar" app slot so the launcher and settings
                     can pick skb as the default calendar app. -->
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>

            <!-- Round 2.18.E.2 — "go to date" intent.
                 content://com.android.calendar/time/<epoch-seconds> is
                 the OS contract for jumping the active calendar to a
                 date. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content"
                      android:host="com.android.calendar"
                      android:pathPrefix="/time" />
            </intent-filter>
            <!-- Phase O.2 — strictlykeptboy://share deep links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="strictlykeptboy" android:host="share" />
            </intent-filter>

            <!-- Phase MM.1 — per-entity custom-scheme deep links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="strictlykeptboy" android:host="event" />
                <data android:scheme="strictlykeptboy" android:host="task" />
                <data android:scheme="strictlykeptboy" android:host="repo" />
                <data android:scheme="strictlykeptboy" android:host="bonus" />
                <data android:scheme="strictlykeptboy" android:host="review" />
            </intent-filter>

            <!-- Phase MM.3 — universal-link variant for SMS/email-friendly delivery. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="strictlykeptboy.app" android:pathPrefix="/link/" />
                <data android:scheme="http" android:host="strictlykeptboy.app" android:pathPrefix="/link/" />
            </intent-filter>
        </activity>

        <!-- Round 2.18.E.3 — EventDetailActivity alias. Calendar
             apps + launchers fire VIEW + vnd.android.cursor.item/event
             with content://com.android.calendar/events/<id> when the
             user taps an event row. Aliasing into MainActivity keeps a
             single Activity instance serving every role. -->
        <activity-alias
            android:name=".EventDetailActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
        </activity-alias>

        <!-- Round 2.18.E.4 — EventEditActivity alias. Calendar
             apps + add-to-calendar share sheets fire EDIT/INSERT with
             vnd.android.cursor.item/event (one row) or
             vnd.android.cursor.dir/event (new row in any calendar). -->
        <activity-alias
            android:name=".EventEditActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity-alias>

        <!-- Round 2.18.E.5 — IcsImportActivity alias. Two filters:
             local-file/content `text/calendar` (mail attachments,
             downloads) and `https://*/*.ics` from a browser. -->
        <activity-alias
            android:name=".IcsImportActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="text/calendar" />
                <data android:scheme="content" android:mimeType="text/calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="*" android:pathPattern=".*\\.ics" />
                <data android:scheme="http" android:host="*" android:pathPattern=".*\\.ics" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Round 2.18.G.2 — AccountManager authenticator. Exposes
             SkbAccountAuthenticator under the `com.eight87.strictlykeptboy`
             account type. The framework binds + queries this service
             via the intent-filter below + the authenticator xml. -->
        <service
            android:name=".system.SkbAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- Round 2.18.G.4 — sync adapter service. Pairs the
             com.android.calendar authority with our account type. -->
        <service
            android:name=".system.SkbSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_calendar" />
        </service>

        <!-- Phase Q — Android Auto template surface (UI-S / D.17). -->
        <service
            android:name=".auto.SkbCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name=".notif.ReminderBroadcastReceiver"
            android:exported="false" />

        <!-- Phase 2.1.F.8 — re-arm reminders after reboot / package replace. -->
        <receiver
            android:name=".notif.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phase XX.3 / AT-C — atomic event start/end alarms. -->
        <receiver
            android:name=".notif.AtomicEventReceiver"
            android:exported="false" />

        <!-- Phase XX.9 / AT-I — sub-beat boundary alarms. -->
        <receiver
            android:name=".notif.SubbeatBoundaryReceiver"
            android:exported="false" />

        <!-- Phase VV — homescreen countdown widget. -->
        <receiver
            android:name=".widget.countdown.CountdownWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <activity
            android:name=".widget.countdown.CountdownWidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Phase EEE — now widget (home + lockscreen). -->
        <receiver
            android:name=".widget.now.NowWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>
        <activity
            android:name=".widget.now.NowWidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
